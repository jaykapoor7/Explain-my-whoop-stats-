# ---------------------------------------------------------------------------
# Health OS — environment variables
#
# All of these are OPTIONAL. If you leave them unset, the app asks for your
# Google OAuth client ID + secret in the UI and stores them in httpOnly
# cookies in your own browser instead.
#
# Set GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET on the deployment to give every
# visitor a single-tap "Connect with Google" — nobody has to touch the Google
# Cloud console. New devices can then be added by scanning the in-app QR
# ("Add a device"), which carries the connection over without reconnecting.
#
# NEVER commit a filled-in .env file. Copy this to .env.local (git-ignored).
# ---------------------------------------------------------------------------

# Google OAuth 2.0 Web application client, created in the Google Cloud console
# with the Google Health API enabled. The ID always ends in
# .apps.googleusercontent.com — this is NOT a legacy Fitbit client ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin of your deployment, e.g. https://health-os.vercel.app
# Used to build the OAuth redirect URI: $APP_URL/api/fitbit/callback
# It must match a redirect URI registered on the OAuth client exactly.
# Leave blank locally and the request origin is used instead.
APP_URL=

# ---------------------------------------------------------------------------
# Accounts + cloud sync ("Sign in with Google")
# ---------------------------------------------------------------------------

# Signs the session cookie and encrypts stored Google refresh tokens.
# Set a long random string in production, e.g. `openssl rand -base64 32`.
# If unset, an insecure dev default is used (fine locally, NOT for production).
AUTH_SECRET=

# Postgres connection string for accounts + per-user cloud snapshots. Any
# managed Postgres works — Neon and Supabase have free tiers and take ~2 min.
# Example: postgres://user:pass@host/db?sslmode=require
# If unset, the app falls back to a local JSON file under .data/ (single
# server only) so it runs with zero setup for development.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Other wearable connectors (optional)
# ---------------------------------------------------------------------------
# Each is a normal OAuth app you register with that provider; set its client
# id/secret and the connector appears on Settings → Other wearables. Register
# the redirect URI $APP_URL/api/connect/<provider>/callback with each provider.
# Oura is fully mapped; the others connect but their data mapping is still
# being finalised against real responses.

OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
