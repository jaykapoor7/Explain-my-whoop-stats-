# Live wearable connections (optional). Without these, the Connections page shows
# an in-app setup guide and the "simulated sync" still works with no configuration.
#
# Register a developer app per provider, set its redirect URL to
#   https://<your-domain>/api/oauth/<provider>/callback
# then add the credentials below (in Vercel: Project -> Settings -> Environment Variables).

# WHOOP — https://developer.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Oura — https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Fitbit — https://dev.fitbit.com/apps
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

# Optional: pin the OAuth redirect base URL (otherwise derived from the request origin).
# APP_URL=https://your-app.vercel.app
