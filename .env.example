# ---------------------------------------------------------------------------
# Health OS — environment variables
#
# All of these are OPTIONAL. If you leave them unset, the app asks for your
# Google OAuth client ID + secret in the UI and stores them in httpOnly
# cookies in your own browser instead.
#
# Set GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET on the deployment to give every
# visitor a single-tap "Connect with Google" — nobody has to touch the Google
# Cloud console. New devices can then be added by scanning the in-app QR
# ("Add a device"), which carries the connection over without reconnecting.
#
# NEVER commit a filled-in .env file. Copy this to .env.local (git-ignored).
# ---------------------------------------------------------------------------

# Google OAuth 2.0 Web application client, created in the Google Cloud console
# with the Google Health API enabled. The ID always ends in
# .apps.googleusercontent.com — this is NOT a legacy Fitbit client ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin of your deployment, e.g. https://health-os.vercel.app
# Used to build the OAuth redirect URI: $APP_URL/api/fitbit/callback
# It must match a redirect URI registered on the OAuth client exactly.
# Leave blank locally and the request origin is used instead.
APP_URL=
